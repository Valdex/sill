<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pure checks of the Windows client's logic, in the spirit of upstream's Tests/checks: a console
       program on plain .NET (not -windows, no packages) that compiles the client's files that need
       neither WinForms nor Win32, exactly as they are, and runs assertions with a pass/fail count.
       Runs anywhere the .NET SDK does (Program.cs has the command line). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Sill.Checks</RootNamespace>
    <AssemblyName>SillChecks</AssemblyName>
    <!-- Not invariant: WindowsNames composes a Mac's decomposed names (string.Normalize), which needs
         ICU (Windows has it, macOS has it, most Linux systems do); Program.cs sets the invariant
         culture, so no number in a check depends on the system's language. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Sill.Windows\Protocol\*.cs" Link="Client\Protocol\%(Filename)%(Extension)" />
    <Compile Include="..\Sill.Windows\Video\KeyframeRecovery.cs" Link="Client\Video\%(Filename)%(Extension)" />
    <Compile Include="..\Sill.Windows\Input\KeyMap.cs;..\Sill.Windows\Input\MacKeys.cs" Link="Client\Input\%(Filename)%(Extension)" />
    <Compile Include="..\Sill.Windows\Audio\JitterBuffer.cs;..\Sill.Windows\Audio\AudioReceiver.cs" Link="Client\Audio\%(Filename)%(Extension)" />
    <!-- Coherence and the Mac's menus: every file in these folders is pure by rule. -->
    <Compile Include="..\Sill.Windows\Coherence\*.cs" Link="Client\Coherence\%(Filename)%(Extension)" />
    <Compile Include="..\Sill.Windows\Menus\*.cs" Link="Client\Menus\%(Filename)%(Extension)" />
    <!-- M4 and M5: the clipboard's rules, files in parts, drag and drop's phases, the Mac's shares. -->
    <Compile Include="..\Sill.Windows\Clipboard\ClipboardRules.cs;..\Sill.Windows\Clipboard\CfHtml.cs;..\Sill.Windows\Clipboard\Images.cs" Link="Client\Clipboard\%(Filename)%(Extension)" />
    <Compile Include="..\Sill.Windows\Data\Transfers.cs;..\Sill.Windows\Data\UploadPacer.cs;..\Sill.Windows\Data\WindowsNames.cs;..\Sill.Windows\Data\FolderZip.cs;..\Sill.Windows\Data\DataLinkPolicy.cs;..\Sill.Windows\Data\ShellFormats.cs" Link="Client\Data\%(Filename)%(Extension)" />
    <Compile Include="..\Sill.Windows\DragDrop\DragMachines.cs" Link="Client\DragDrop\%(Filename)%(Extension)" />
    <Compile Include="..\Sill.Windows\Shares\PathMapping.cs" Link="Client\Shares\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Mac's own encodings of the Coherence messages (Tests/checks/coherence-fixtures). -->
    <None Include="Fixtures\*.jsonl" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
